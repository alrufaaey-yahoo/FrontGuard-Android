<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ترويسة التطبيق -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FrontGuard Proxy"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="CF/Google Fronting Proxy — متوافق مع OpenSSL 3.x (SKI/AKI)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- شريط الحالة -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#37474F"
            android:gravity="center"
            android:padding="10dp"
            android:text="متوقف حالياً"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- أزرار التشغيل وتصدير الشهادة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnToggleProxy"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="تشغيل البروكسي (START)"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExportCa"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#334155"
                android:text="تصدير CA"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- بطاقة الإعدادات الأساسية -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الإعدادات الأساسية (Listening &amp; Fronts)"
                android:textColor="#38BDF8"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عنوان الاستماع (Listen IP)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etListenHost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="0.0.0.0"
                        android:inputType="text"
                        android:text="0.0.0.0"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="المنفذ (Port)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etListenPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="8080"
                        android:inputType="number"
                        android:text="8080"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="النطاقات الأمامية (--fronts مفصولة بفاصلة)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etFronts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="google.com"
                        android:inputType="textUri"
                        android:text="google.com"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="منفذ Front"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etFrontPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="443"
                        android:inputType="number"
                        android:text="443"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="وضع SNI (--sni-mode):"
                    android:textColor="@color/text_primary" />

                <Spinner
                    android:id="@+id/spinnerSniMode"
                    android:layout_width="150dp"
                    android:layout_height="42dp" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchMitm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="تفعيل اعتراض MITM (--mitm: SNI=front, Host=target)"
                android:textColor="@color/text_primary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchInsecure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="تجاوز التحقق عند الفشل (--insecure)"
                android:textColor="@color/text_primary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchVerbose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="سجل تفصيلي للاتصالات (--verbose)"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- بطاقة الخيارات المتقدمة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="خيارات متقدمة (Timeout, Retry, Auth, Blacklist)"
                android:textColor="#38BDF8"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="المهلة بالثواني (--timeout)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etTimeout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="20"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عدد المحاولات (--retry)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etRetry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="2"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/etAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="مصادقة البروكسي (--auth اختياري)"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <EditText
                android:id="@+id/etBlacklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="القائمة السوداء (--blacklist نطاقات مفصولة بفاصلة)"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <EditText
                android:id="@+id/etUserAgent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="تخصيص User-Agent (--user-agent اختياري)"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />
        </LinearLayout>

        <!-- شاشة السجل المباشر -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="سجل العمليات المباشر (Live Logs)"
                    android:textColor="#38BDF8"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCopyLogs"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="نسخ"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnClearLogs"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="مسح"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollLogs"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="6dp"
                android:background="#090D16"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#10B981"
                    android:textDirection="ltr"
                    android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
